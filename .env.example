# Orkelya Autonomous Content Engine Environment Variables

# Database
POSTGRES_USER=orkelya_admin
POSTGRES_PASSWORD=
POSTGRES_DB=orkelya_content_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Storage (S3 / R2 / MinIO)
STORAGE_ENDPOINT=http://minio:9000
STORAGE_BUCKET=orkelya-assets
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# LLM Providers (OpenAI, Anthropic, ElevenLabs)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Social Platform Adapters (Meta, LinkedIn, TikTok, YouTube, X)
META_GRAPH_API_TOKEN=
LINKEDIN_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
YOUTUBE_CLIENT_SECRET=
X_API_KEY=

# Control & Security
HUMAN_OVERRIDE_PAUSE_ALL=false
QA_MINIMUM_SCORE_THRESHOLD=85
