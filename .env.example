# Orkelya Autonomous Content Engine Environment Variables

# Database
POSTGRES_USER=orkelya_admin
POSTGRES_PASSWORD=orkelya_secret_password
POSTGRES_DB=orkelya_content_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://orkelya_admin:orkelya_secret_password@localhost:5432/orkelya_content_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Storage (S3 / R2 / MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=orkelya-assets
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# LLM Providers (OpenAI, Anthropic, ElevenLabs)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Social Platform Adapters (Meta, LinkedIn, TikTok, YouTube, X)
META_GRAPH_API_TOKEN=your_meta_graph_api_token
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
X_API_KEY=your_x_api_key

# Control & Security
HUMAN_OVERRIDE_PAUSE_ALL=false
QA_MINIMUM_SCORE_THRESHOLD=85
